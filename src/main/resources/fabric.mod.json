{
	"schemaVersion": 1,
	"id": "${modId}",
	"version": "${version}",
	"name": "${modName}",
	"description": "${modDescription}",
	"authors": [
		"${authors}"
	],
	"contributors": [
		"${contributors}"
	],
	"contact": {
		"homepage": "${homepage}",
		"issues": "${issues}",
		"sources": "${sources}"
	},
	"license": "${license}",
	"icon": "assets/${modId}/icon.png",
	"mixins": [
		{
			"config": "enamel.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"minecraft": ">=${minecraftVersion}",
		"fabricloader": ">=${fabricLoaderVersion}",
		"fabric-api": ">=${fabricApiVersion}",
		"trinkets":">=4.0.0-alpha.6+26.1"
	},
	"suggests": {
	},
	"entrypoints": {
		"main": [
          "io.github.Jackwastakenx2.enamel.Enamel"
		],
		"client": [

		],
		"fabric-datagen": [
			"io.github.Jackwastakenx2.enamel.datagen.EnamelDatagen"
		]
	}
}
